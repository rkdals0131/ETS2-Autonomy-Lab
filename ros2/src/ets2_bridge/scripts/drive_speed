#!/usr/bin/env python3
"""Keep the original ROS command; replace this process with the autonomy node."""
import os
from pathlib import Path
import sys

from ament_index_python.packages import get_package_prefix

executable = Path(get_package_prefix("ets2_autonomy")) / "lib" / "ets2_autonomy" / "drive_speed"
os.execv(str(executable), [str(executable), *sys.argv[1:]])
